<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <AutoTabFrame
        id="media/tabFrame"
        grow="1"
        defaultTab="0"
        tabHeight="50"
        tabItemActiveTextColor="@theme/color/app"
        sidebarPosition="top">

        <Tab label="@i18n/main/tabs/home"
            fontSize="18">
            <brls:Box
                grow="1"
                paddingLeft="30"
                paddingRight="30"
                paddingTop="15"
                paddingBottom="20">
                <RecyclingGrid
                    grow="1"
                    wireframe="false"
                    spanCount="6"
                    itemHeight="280"
                    id="media/series" />
            </brls:Box>
        </Tab>
    </AutoTabFrame>

    <ButtonClose
        positionType="absolute"
        positionTop="2"
        positionRight="2" />

</brls:Box>
