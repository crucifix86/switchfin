<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <!-- Home Header -->
    <brls:Box
        width="100%"
        height="60"
        backgroundColor="@theme/color/header_bg"
        paddingLeft="30"
        alignItems="center">
        <brls:Label
            fontSize="28"
            text="Home" />
    </brls:Box>

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            axis="column"
            id="home/box"
            paddingLeft="30"
            paddingRight="30"
            paddingTop="20"
            paddingBottom="30">

            <RecylingVideo
                nextPage="auto"
                resume="true"
                pageSize="10"
                frameHeight="200"
                itemWidth="260"
                id="home/user/resume"
                title="@i18n/main/home/resume" />

            <RecylingVideo
                nextPage="auto"
                pageSize="8"
                frameHeight="240"
                itemWidth="300"
                id="home/show/nextup"
                visibility="gone"
                title="@i18n/main/home/nextup" />

            <!-- Latest [Library] rows added dynamically by home_tab.cpp -->

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
