<brls:AppletFrame
    id="main/frame"
    iconInterpolation="linear"
    headerHidden="true"
    footerHidden="false">
    <brls:Box
        axis="column"
        width="100%"
        height="100%">
        <AutoTabFrame
            id="main/tabFrame"
            grow="1"
            sidebarWidth="220"
            tabBackgroundColor="@theme/color/sidebar_bg"
            tabItemActiveTextColor="@theme/color/app"
            defaultTab="0"
            sidebarPosition="left">

            <Tab label="Home"
                fontSize="20"
                style="accent">
                <HomeTab />
            </Tab>

            <!-- All other tabs added dynamically by main_activity.cpp -->

        </AutoTabFrame>
    </brls:Box>
</brls:AppletFrame>
