<brls:Box
    highlightCornerRadius="6"
    axis="column"
    width="auto"
    height="auto">
    <brls:Box
        id="video/card/pic_box"
        axis="row"
        grow="1">
        <brls:Image
            id="video/card/picture"
            backgroundColor="@theme/color/grey_1"
            grow="1"
            scalingType="fill"
            image="@res/img/video-card-bg.png"
            cornerRadius="6" />

        <SVGImage
            id="video/card/badge/top"
            positionType="absolute"
            positionTop="8"
            positionRight="8"
            height="24" />

        <SVGImage
            id="video/card/badge/favorite"
            svg="@res/icon/ico-heart.svg"
            visibility="invisible"
            positionType="absolute"
            positionBottom="8"
            positionRight="8"
            height="24" />

        <brls:Box
            positionBottom="0"
            positionType="absolute"
            background="vertical_linear"
            paddingLeft="10"
            paddingRight="10"
            width="100%"
            height="15%"
            alignItems="center">
            <brls:Image
                id="video/card/badge/bottom/left"
                scalingType="fit"
                height="16" />
            <brls:Label
                id="video/card/label/rating"
                positionType="absolute"
                positionRight="0"
                textColor="#FFFFFF"
                fontSize="14" />
        </brls:Box>

        <!-- Progress bar - more visible -->
        <brls:Box
            wireframe="false"
            positionType="absolute"
            positionBottom="0"
            visibility="gone"
            width="100%"
            height="4"
            backgroundColor="#333340">
            <brls:Rectangle
                id="video/card/progress"
                height="4"
                width="50%"
                color="@theme/color/app" />
        </brls:Box>

    </brls:Box>

    <brls:Box
        axis="column"
        justifyContent="spaceEvenly"
        alignItems="center"
        marginTop="8">
        <brls:Label
            wireframe="false"
            id="video/card/label/title"
            height="26"
            fontSize="18" />
        <brls:Label
            wireframe="false"
            id="video/card/label/ext"
            fontSize="14"
            height="20"
            textColor="@theme/font/grey" />
    </brls:Box>

</brls:Box>
